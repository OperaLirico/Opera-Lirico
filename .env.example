# Copy to .env for local development.
# Never put real credentials in this file or commit .env.

# Optional future Supabase integration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-side use only; never expose this in browser code.
# Keep the service-role key in GitHub Actions Secrets or a local untracked .env.
SUPABASE_SERVICE_ROLE_KEY=
