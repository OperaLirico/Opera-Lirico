{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opera Lirico masterclass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "source_name",
    "source_url",
    "publisher_status",
    "review_status",
    "publication_status",
    "checked_at",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "teacher": {
      "type": "string"
    },
    "instrument_or_voice": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "application_deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "fee_eur": {
      "type": "number",
      "minimum": 0
    },
    "language": {
      "type": "string"
    },
    "description_zh": {
      "type": "string"
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "application_url": {
      "type": "string",
      "format": "uri"
    },
    "publisher_status": {
      "enum": [
        "official",
        "third_party",
        "unknown"
      ]
    },
    "review_status": {
      "enum": [
        "pending_manual_review",
        "verified",
        "rejected"
      ]
    },
    "publication_status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "excerpt",
          "checked_at"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "date_label_zh": {
      "type": "string",
      "minLength": 1
    },
    "title_zh": {
      "type": "string",
      "minLength": 1
    },
    "focus_zh": {
      "type": "string"
    },
    "fee_label_zh": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_status": {
            "const": "published"
          }
        },
        "required": [
          "publication_status"
        ]
      },
      "then": {
        "properties": {
          "review_status": {
            "const": "verified"
          },
          "publisher_status": {
            "const": "official"
          }
        }
      }
    }
  ]
}
